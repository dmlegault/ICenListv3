# =============================================================================
# enList v3 — .gitignore
# .NET 10 + net472 solution, plus the local demo tooling under demo/ and .demo/.
# =============================================================================

# --- Build output -----------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# --- Visual Studio / Rider / VS Code ----------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*_i.c
*_p.c
*.rsp

# --- NuGet -------------------------------------------------------------------
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json

# --- Test results ------------------------------------------------------------
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage/

# =============================================================================
# Secrets — never commit
# =============================================================================
# The demo SQL Server's SA password lives here. The template stays tracked.
.env
!*.env.example

# Claude Code per-machine permissions (personal). launch.json stays tracked.
.claude/settings.local.json

# =============================================================================
# Generated runtime state — recreated by the demo, not source
# =============================================================================
# Content-addressed package storage, wherever a control plane writes it.
PackageBlobs/

# The demo agents' on-disk working set and captured process logs. The README
# that documents the directory is kept; everything else is regenerated by
# demo/start-demo.ps1 (see .demo/README.md).
/.demo/*
!/.demo/README.md

# Built sample payloads: rebuilt into deploy/<App>/ by `dotnet build` on each
# sample. The README that documents the directory is kept (see deploy/README.md).
/deploy/*
!/deploy/README.md

# Built test plugins. Same idea as deploy/, kept out of it on purpose: everything
# under deploy/ is demo material the portal shows, and these are broken by design
# (tests/Enlist.TestPlugins.Misbehaving).
/.testplugins/

# --- OS cruft ----------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
