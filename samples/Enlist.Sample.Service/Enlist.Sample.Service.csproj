<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Enlist.Sample.Service</RootNamespace>

    <!-- Drops straight into a directory shaped like an already-deployed application, so the test
         harness (and any manual "enlist-runner, pointed at an app folder" run) can point at it with
         zero copying. -->
    <OutputPath>..\..\deploy\SampleService\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Pulls in the Enlist attribute contract as SOURCE, not as a compiled assembly — see
       contracts/EnlistAttributes.cs for why that's the whole point of the design. -->
  <Import Project="..\..\contracts\Enlist.Contracts.props" />

  <ItemGroup>
    <None Include="Enlist.Sample.Service.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
