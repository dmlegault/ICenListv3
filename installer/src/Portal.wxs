<?xml version="1.0" encoding="utf-8"?>
<!--
  Enlist.Portal.msi.

  The smallest of the three. It lays down the published portal, creates its data root, and installs
  the service pointed at a control plane.

  What it does not carry is the portal's own key to the control plane. That key is a secret: section 8
  has the bootstrapper mint it with the control plane's create-api-key verb and store it with
  Enlist.Portal.exe protect, as a dpapi: value in appsettings.json. It is never a service argument,
  because a binPath is readable by any local user. A portal installed by this MSI alone therefore
  starts, reports its own 401 clearly (Runbook 3.20), and waits for that key.

  The content root needs no help from here: Program.cs already sets it from AppContext.BaseDirectory
  when it detects the SCM started it, which is what stops the broken-static-assets failure in
  Runbook 3.5 from reappearing as a service.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?include Common.wxi ?>

  <Package
    Name="enList Portal"
    Manufacturer="$(Manufacturer)"
    Version="$(ProductVersion)"
    UpgradeCode="0862364B-CF64-4EB6-B39A-2A5814AD7BED"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade
      Schedule="afterInstallExecute"
      DowngradeErrorMessage="A newer version of the enList Portal is already installed. Uninstall it first if you mean to go back." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="PORTAL_INSTALLDIR" Secure="yes" />
    <Property Id="PORTAL_DATADIR" Secure="yes" />

    <!-- https for the same reason the control plane uses it: Required refuses plain HTTP off loopback. -->
    <Property Id="PORTAL_URLS" Secure="yes" />
    <SetProperty Id="PORTAL_URLS" Sequence="both" Before="CostInitialize" Condition="NOT PORTAL_URLS" Value="https://+:5231" />
    <Property Id="PORTAL_CPURL" Secure="yes" />

    <Property Id="PORTAL_ACCOUNT" Secure="yes" />
    <SetProperty Id="PORTAL_ACCOUNT" Sequence="both" Before="CostInitialize"
                 Condition="NOT PORTAL_ACCOUNT" Value="NT AUTHORITY\NetworkService" />
    <Property Id="PORTAL_PASSWORD" Secure="yes" Hidden="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ENLISTROOT" Name="enList">
        <Directory Id="INSTALLFOLDER" Name="Portal" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAROOT" Name="enList">
        <Directory Id="PORTALDATA" Name="Portal">
          <Directory Id="PORTALLOGS" Name="Logs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <SetProperty Id="PORTAL_DATADIR" Sequence="both" Before="CostInitialize"
                 Condition="NOT PORTAL_DATADIR" Value="[CommonAppDataFolder]enList\Portal" />

    <SetDirectory Id="INSTALLFOLDER" Value="[PORTAL_INSTALLDIR]" Condition="PORTAL_INSTALLDIR" Sequence="both" />
    <SetDirectory Id="PORTALDATA" Value="[PORTAL_DATADIR]" Condition="PORTAL_DATADIR" Sequence="both" />

    <SetProperty Id="PORTAL_SERVICE_ARGS" Action="SetPortalArgs" Sequence="execute" After="CostFinalize"
                 Value="--urls &quot;[PORTAL_URLS]&quot;" />

    <!--
      Omitted rather than set empty when no control plane URL was given. The portal reports a missing
      ControlPlane:BaseUrl as a clear startup failure; an empty one would be a confusing connection
      error instead.
    -->
    <SetProperty Id="PORTAL_SERVICE_ARGS" Action="SetPortalArgsControlPlane" Sequence="execute" After="SetPortalArgs"
                 Condition="PORTAL_CPURL"
                 Value="[PORTAL_SERVICE_ARGS] --ControlPlane:BaseUrl=&quot;[PORTAL_CPURL]&quot;" />

    <Feature Id="Main" Title="enList Portal" Level="1">
      <ComponentGroupRef Id="PortalFiles" />
      <ComponentRef Id="PortalService" />
      <ComponentRef Id="PortalDataFolder" />
    </Feature>

    <ComponentGroup Id="PortalFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PortalStaging)\**" />
    </ComponentGroup>

    <Component Id="PortalService" Directory="INSTALLFOLDER" Guid="E4A8C2B9-6F31-4D75-A0C6-9B2E7F14D583">
      <File Id="PortalExe" Source="$(PortalPublish)\Enlist.Portal.exe" KeyPath="yes" />

      <ServiceInstall
        Id="PortalServiceInstall"
        Name="$(PortalServiceName)"
        DisplayName="enList Portal"
        Description="The enList web portal. Signs people in with Windows and talks to the control plane with its own key."
        Type="ownProcess"
        Start="auto"
        ErrorControl="normal"
        Account="[PORTAL_ACCOUNT]"
        Password="[PORTAL_PASSWORD]"
        Arguments="[PORTAL_SERVICE_ARGS]"
        Vital="yes">
        <util:ServiceConfig
          FirstFailureActionType="restart"
          SecondFailureActionType="restart"
          ThirdFailureActionType="none"
          RestartServiceDelayInSeconds="60"
          ResetPeriodInDays="1" />
      </ServiceInstall>

      <!-- Created stopped: it has no key to the control plane yet. See the header. -->
      <ServiceControl
        Id="PortalServiceControl"
        Name="$(PortalServiceName)"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
    </Component>

    <Component Id="PortalDataFolder" Directory="PORTALDATA" Guid="7C15E8B2-3A46-49D0-8F97-2E6B4A1D905C" NeverOverwrite="yes" Permanent="yes">
      <CreateFolder Directory="PORTALLOGS">
        <util:PermissionEx User="[PORTAL_ACCOUNT]" GenericAll="yes" />
      </CreateFolder>
      <RegistryValue Root="HKLM" Key="SOFTWARE\enList\Portal" Name="DataDirectory" Type="string" Value="[PORTALDATA]" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
