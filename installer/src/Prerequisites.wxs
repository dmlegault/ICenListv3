<?xml version="1.0" encoding="utf-8"?>
<!--
  The .NET runtimes the bundle installs before anything else, as remote payloads.

  GENERATED METADATA, NOT A GENERATED FILE. The hashes and sizes below came from
  `wix burn remotepayload` run against the official installers; `tools/refresh-prerequisites.ps1`
  regenerates them. The binaries are never committed - the bundle carries only the URL, hash and
  size, and Burn downloads and verifies at install time. That keeps a 42 MB pair of Microsoft
  installers out of the repository and out of the bundle, at the cost of an install needing network
  access, which it needs anyway to reach a control plane.

  TWO PACKAGES, NOT ONE, because the two install types need different things: an agent needs only
  Microsoft.NETCore.App, while the control plane and portal also need Microsoft.AspNetCore.App. The
  ASP.NET Core installer is the smaller of the two precisely because it does not carry the base
  runtime, so a Server install genuinely needs both.

  A CORRECTION TO THE DESIGN. Installer-UI-Design.md section 4 names the ASP.NET Core HOSTING BUNDLE
  for the control plane and portal. That is the right package for something hosted by IIS, and it is
  117 MB against 11 MB, because the extra is the IIS ASP.NET Core Module. Nothing enList installs
  runs under IIS: the control plane and the portal are Kestrel behind a Windows service, which is the
  only hosting the pages offer. So the plain ASP.NET Core Runtime is used instead. If IIS hosting is
  ever offered, this is the package to revisit.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>
    <!--
      Bitness="always32" states the REGISTRY VIEW rather than changing it. The .NET installers write
      their records to the 32-bit view - HKLM\SOFTWARE\dotnet under x64 is empty and everything lives
      under WOW6432Node - and a Burn RegistrySearch already reads that view unless told otherwise. So
      this is documentation with teeth: it is what someone would reach for if a search ever came back
      empty, and writing it down stops the next person adding Win64="yes" to "fix" something and
      breaking every check on every machine.

      Worth recording that this was NOT the cause of the redundant download below, though it was
      confidently written up as such for one commit. The searches were always reading the right view;
      the base runtime check was simply asking the wrong question. Being sure and wrong is cheap to
      write and expensive to read.
    -->

    <!--
      The BASE RUNTIME, read as a version and compared, so any .NET 10 satisfies it.

      This used to look for a value NAMED for the exact patch, because that is how the shared-framework
      key records installations: one DWORD per version, with no "latest" to read. A machine with
      10.0.3 therefore failed a check for 10.0.12 and downloaded 30 MB it did not need - which is what
      happened on the first real run of this bundle, on a machine that had .NET 10 installed.
      Every agent in a fleet needs this package, so that mistake is paid for once per machine.

      hostfxr's Version is the one value in the whole tree that names a version rather than being named
      for one, and the .NET host is updated with every runtime install, so it reports the newest 10.x
      present. Burn parses it into a version variable and the condition below is a real comparison.
    -->
    <util:RegistrySearch
      Id="SearchNetCoreHostVersion"
      Variable="NetCoreHostVersion"
      Root="HKLM"
      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\hostfxr"
      Value="Version"
      Bitness="always32"
      Result="value" />

    <!--
      ASP.NET CORE has no equivalent to hostfxr's Version. Its only record is the same list of
      version-named DWORDs, so the only question a RegistrySearch can ask is whether one exact patch
      is present - and on a machine with 10.0.11 the answer to "is 10.0.12 here" is No, followed by
      an 11 MB download nobody needed.

      THIS SEARCH IS NO LONGER THE ANSWER, ONLY THE FALLBACK. The bootstrapper sets AspNetCorePresent
      before Detect, from RuntimeDetection, which enumerates the key and compares versions the way a
      declarative search cannot. The DetectCondition below is an OR of the two, so:

        - the wizard's answer wins when there is a wizard, which is every bundle built normally;
        - a bundle built with -StandardBootstrapper still detects the exact patch, which
          over-installs at worst rather than losing detection completely.

      Kept exact rather than approximated, for the fallback's sake. The near-miss alternatives ("the
      ASP.NET Core folder exists AND the host is 10.x") are wrong precisely on the machine that has
      ASP.NET Core 8 and a bare .NET 10 runtime, and being wrong THAT way produces a control plane
      that installs and never starts.
    -->
    <util:RegistrySearch
      Id="SearchAspNetCoreRuntime"
      Variable="AspNetCoreRuntimeDetected"
      Root="HKLM"
      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.AspNetCore.App"
      Value="$(DotnetRuntimeVersion)"
      Bitness="always32"
      Result="exists" />

    <PackageGroup Id="Prerequisites">

      <!--
        The base runtime, needed by all three components. Installed whenever anything is being
        installed, which is why it carries no InstallCondition.
      -->
      <ExePackage
        Id="NetCoreRuntime"
        DisplayName="Microsoft .NET Runtime $(DotnetRuntimeVersion) (x64)"
        Permanent="yes"
        Vital="yes"
        Cache="remove"
        PerMachine="yes"
        DetectCondition="NetCoreHostVersion &gt;= v$(DotnetRuntimeMinimum)"
        InstallArguments="/install /quiet /norestart"
        RepairArguments="/repair /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart">
        <ExePackagePayload
          Name="dotnet-runtime-$(DotnetRuntimeVersion)-win-x64.exe"
          ProductName="Microsoft .NET Runtime - $(DotnetRuntimeVersion) (x64)"
          Description="Microsoft .NET Runtime - $(DotnetRuntimeVersion) (x64)"
          DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/Runtime/$(DotnetRuntimeVersion)/dotnet-runtime-$(DotnetRuntimeVersion)-win-x64.exe"
          Hash="B937AE539C4AB21F885B033178DADEA98018BAAD777252C76251E760D81C18463B2F802E86B6A67EA066690E9EDE2D66A6BC3C3E614E391505E98C4C41121400"
          Size="30663104"
          Version="10.0.12.36422" />
      </ExePackage>

      <!--
        ASP.NET Core, needed only when a control plane or a portal is being installed. An agent-only
        install skips it, which is 11 MB and a reboot-free minute saved on every machine in a fleet.

        Permanent: uninstalling enList must not remove a shared .NET runtime that anything else on the
        machine may now depend on.
      -->
      <ExePackage
        Id="AspNetCoreRuntime"
        DisplayName="Microsoft ASP.NET Core Runtime $(DotnetRuntimeVersion) (x64)"
        Permanent="yes"
        Vital="yes"
        Cache="remove"
        PerMachine="yes"
        DetectCondition="AspNetCorePresent = &quot;1&quot; OR AspNetCoreRuntimeDetected"
        InstallCondition="INSTALLTYPE = &quot;Server&quot; OR InstallControlPlane = &quot;1&quot; OR InstallPortal = &quot;1&quot;"
        InstallArguments="/install /quiet /norestart"
        RepairArguments="/repair /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart">
        <ExePackagePayload
          Name="aspnetcore-runtime-$(DotnetRuntimeVersion)-win-x64.exe"
          ProductName="Microsoft ASP.NET Core Runtime - $(DotnetRuntimeVersion) (x64)"
          Description="Microsoft ASP.NET Core Runtime - $(DotnetRuntimeVersion) (x64)"
          DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$(DotnetRuntimeVersion)/aspnetcore-runtime-$(DotnetRuntimeVersion)-win-x64.exe"
          Hash="1BD1CF3CC23A05611BF266046281C7BFB6C3231A9690482DDC31EA74EDE62EADED12517C362983976AA7E20C57108812DCD04F67884957B85A6829CD56CEAAC5"
          Size="11262864"
          Version="10.0.12.36422" />
      </ExePackage>

    </PackageGroup>
  </Fragment>
</Wix>
