<Window x:Class="Enlist.Installer.Ba.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="enList Setup" Height="660" Width="820"
        Icon="media/enlist.ico"
        Background="#1a1a27"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinHeight="560" MinWidth="720">

    <!--
        One window, one page at a time, chosen by the view model rather than by navigation history.
        Which pages exist is InstallPlan.Pages(), so a component that is not being installed has no
        page rather than a skipped one.

        THE PALETTE IS THE PORTAL'S, not a second opinion about what enList looks like. The values
        come from MudTheme in src\Enlist.Portal\Components\Layout\MainLayout.razor, which runs dark
        by default, and the 12px radius is that theme's DefaultBorderRadius. Anyone restyling the
        portal should expect to change these too; they are copied rather than shared because a WPF
        bootstrapper running before .NET 10 exists cannot reference anything the portal uses.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <SolidColorBrush x:Key="Ground" Color="#1a1a27" />
        <SolidColorBrush x:Key="Surface" Color="#242435" />
        <SolidColorBrush x:Key="Bar" Color="#1c1c28" />
        <SolidColorBrush x:Key="Primary" Color="#0088D0" />
        <SolidColorBrush x:Key="PrimaryDim" Color="#006FA8" />
        <SolidColorBrush x:Key="TextPrimary" Color="#f5f5f7" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9a9ab0" />
        <SolidColorBrush x:Key="Line" Color="#33334a" />
        <SolidColorBrush x:Key="Warn" Color="#e4a03a" />
        <SolidColorBrush x:Key="Good" Color="#3fb27f" />

        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Explain">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,10,12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Note">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- A dark theme is not a background colour: every input has to be restated or it stays white. -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="#1e1e2c" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="#1e1e2c" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#2e2e42" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3a3a52" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--
            Templated rather than merely recoloured. A ComboBox's default template paints its own
            chrome from the system theme, so setting Background alone leaves a white control on a dark
            page - the one thing the operator is meant to click.
        -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1e1e2c" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#1e1e2c" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="shell" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                                <Border Background="#242435" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1e1e2c" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="RowBackground" Value="#1e1e2c" />
            <Setter Property="AlternatingRowBackground" Value="#232333" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        </Style>
        <Style TargetType="{x:Type prim:DataGridColumnHeader}">
            <Setter Property="Background" Value="#2a2a3d" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2f2f46" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#1e1e2c" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">

        <!-- Banner. The logo is an embedded Resource, not a bundle payload: a payload can go missing. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bar}" Padding="20,14"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="media/iron-canary-logo.png" Height="30" Stretch="Uniform" />
                <Border Width="1" Background="{StaticResource Line}" Margin="14,2" />
                <TextBlock Text="enList Setup" FontSize="17" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding StepLabel}" FontSize="13" VerticalAlignment="Center" Margin="12,2,0,0"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bar}" Padding="20,14"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Why Next is disabled, beside Next, because a greyed-out button with no reason is the worst thing a page can do. -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding NextBlockedBecause}" Foreground="{StaticResource Warn}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="430" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Width="96" Height="32" Margin="0,0,8,0" />
                    <Button Content="Next" Command="{Binding NextCommand}" Width="96" Height="32" Margin="0,0,8,0"
                            IsDefault="True" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Width="96" Height="32" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Margin="20" Background="{StaticResource Surface}" CornerRadius="12" Padding="26,22">
            <Grid>
                <!-- Welcome -->
                <StackPanel Visibility="{Binding OnWelcome, Converter={StaticResource Visible}}">
                    <TextBlock Text="enList" Style="{StaticResource Heading}" FontSize="30" />
                    <TextBlock Style="{StaticResource Explain}"
                               Text="This installs the enList control plane, portal and agent. Every component can be installed on its own, and an agent can be added to a machine later without touching the rest." />
                    <TextBlock Style="{StaticResource Explain}"
                               Text="Nothing is changed until the Ready page, which lists exactly what will happen." />
                </StackPanel>

                <!--
                    NOTHING ELSE GOES HERE AT THIS LEVEL. There was a ContentControl bound to
                    CurrentPage carrying an implicit DataTemplate for WizardPage whose body was
                    another ContentControl bound to the same value:

                        <DataTemplate DataType="{x:Type detection:WizardPage}">
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>

                    An implicit template applies to anything of its DataType, including the content
                    of the control the template itself creates, so that is unbounded recursion by
                    construction. It cost a StackOverflowException inside WindowsBase, which .NET
                    cannot catch and no handler can log - the process vanished, and all Burn could
                    report was that the pipe had closed. The Grid below is what switches pages, and
                    always was.
                -->

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OnWelcome}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Install type -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="InstallType">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="What should this machine run?" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Explain}"
                                   Text="This decides which components are installed and which pages follow." />

                        <!--
                            IsChecked IS BOUND. These were three unbound radio buttons with Server
                            hard-checked, so choosing Agent only changed the dot and nothing else:
                            the plan stayed Server and the wizard could not produce any other
                            install. A radio button that does not write anywhere is a lie about what
                            the operator chose.
                        -->
                        <RadioButton GroupName="Type" IsChecked="{Binding IsServer}"
                                     Content="Server - the control plane and the portal. The one box that hosts enList." />
                        <RadioButton GroupName="Type" IsChecked="{Binding IsAgentOnly}"
                                     Content="Agent only - every machine that will run applications." />
                        <RadioButton GroupName="Type" IsChecked="{Binding IsCustom}"
                                     Content="Custom - any combination, for split tiers or adding a component later." />

                        <Border Margin="24,10,0,0" Padding="16,10" CornerRadius="8" Background="#1e1e2c"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Visibility="{Binding IsCustom, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Components" Foreground="{StaticResource TextSecondary}" />
                                <CheckBox IsChecked="{Binding WantControlPlane}" Content="Control plane" />
                                <CheckBox IsChecked="{Binding WantPortal}" Content="Portal" />
                                <CheckBox IsChecked="{Binding WantAgent}" Content="Agent" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Prerequisites -->
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Prerequisites">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <TextBlock DockPanel.Dock="Top" Text="What this machine already has" Style="{StaticResource Heading}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Explain}"
                                   Text="Missing runtimes are installed for you. A container engine is optional: without one the agent runs applications as processes, which is a perfectly good agent." />
                        <Button DockPanel.Dock="Bottom" Content="Re-check" Width="110" Height="30"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding RecheckCommand}" />

                        <DataGrid ItemsSource="{Binding Prerequisites}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="190" />
                                <DataGridTextColumn Header="Needed by" Binding="{Binding NeededBy}" Width="180" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Control plane -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="ControlPlane">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Control plane" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Explain}"
                                   Text="Holds the policy rules, packages and agent registry, and pushes changes out to agents." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Listen on" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ControlPlaneUrls, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Note}"
                                       Text="https, not http. Authentication is Required unless configured otherwise, and Required refuses plain HTTP anywhere but loopback - an http value here installs cleanly and then never starts." />

                            <TextBlock Grid.Row="2" Text="Certificate" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                      ItemsSource="{Binding Certificates}"
                                      SelectedItem="{Binding ControlPlaneCertificate}"
                                      DisplayMemberPath="Display" />

                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Note}"
                                       Text="{Binding ControlPlaneCertificateProblem}" Foreground="{StaticResource Warn}" />

                            <TextBlock Grid.Row="4" Text="Service account" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding ControlPlaneAccount, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5" Text="Password" Style="{StaticResource Label}" />
                            <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="ControlPlanePasswordBox"
                                         PasswordChanged="ControlPlanePasswordBox_PasswordChanged" />

                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Note}"
                                       Text="Leave blank for the built-in accounts - NETWORK SERVICE and LOCAL SYSTEM have no password. The chosen account is given read access to the certificate's private key during the install, which it does not have by default." />

                            <TextBlock Grid.Row="7" Text="Install to" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="7" Grid.Column="1"
                                     Text="{Binding ControlPlaneInstallDir, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Leave blank for %ProgramFiles%\enList\ControlPlane." />
                        </Grid>
                    </StackPanel>

                    <!-- Database -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Database">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Database" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Explain}"
                                   Text="The control plane keeps everything here. The schema is applied during the install, not now." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SQL Server" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding DatabaseServer, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Test" Width="80" Height="28" Margin="8,8,0,0"
                                    Command="{Binding TestDatabaseCommand}" />

                            <TextBlock Grid.Row="1" Text="Database name" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                       Text="{Binding DatabaseVerdict}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}" />

                            <TextBlock Grid.Row="3" Text="Sign in with" Style="{StaticResource Label}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                <RadioButton GroupName="DbAuth" IsChecked="{Binding DatabaseWindowsAuth}"
                                             Content="Windows authentication - the service account connects as itself" />
                                <RadioButton GroupName="DbAuth" IsChecked="{Binding DatabaseSqlAuth}"
                                             Content="A SQL Server login" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Login" Style="{StaticResource Label}"
                                       Visibility="{Binding DatabaseSqlAuth, Converter={StaticResource Visible}}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Visibility="{Binding DatabaseSqlAuth, Converter={StaticResource Visible}}"
                                     Text="{Binding DatabaseUser, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5" Text="Password" Style="{StaticResource Label}"
                                       Visibility="{Binding DatabaseSqlAuth, Converter={StaticResource Visible}}" />
                            <PasswordBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DatabasePasswordBox"
                                         Visibility="{Binding DatabaseSqlAuth, Converter={StaticResource Visible}}"
                                         PasswordChanged="DatabasePasswordBox_PasswordChanged" />

                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Note}"
                                       Visibility="{Binding DatabaseSqlAuth, Converter={StaticResource Visible}}"
                                       Text="A SQL password is never put on the service command line, where any local user could read it out of the process list. It is written to an ACL-restricted appsettings.json during the install instead." />
                        </Grid>
                    </StackPanel>

                    <!-- Portal -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Portal">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Portal" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Explain}"
                                   Text="The web interface. People sign in with Windows; the portal talks to the control plane with a key of its own." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Listen on" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding PortalUrls, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="Certificate" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                      ItemsSource="{Binding Certificates}"
                                      SelectedItem="{Binding PortalCertificate}"
                                      DisplayMemberPath="Display" />

                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Note}"
                                       Text="{Binding PortalCertificateProblem}" Foreground="{StaticResource Warn}" />

                            <TextBlock Grid.Row="3" Text="Control plane" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding PortalControlPlaneUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Note}"
                                       Text="Where the portal reaches the control plane. On a single Server install this is the address above it." />

                            <TextBlock Grid.Row="5" Text="Service account" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding PortalAccount, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="6" Text="Password" Style="{StaticResource Label}" />
                            <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="PortalPasswordBox"
                                         PasswordChanged="PortalPasswordBox_PasswordChanged" />

                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Note}"
                                       Text="The portal's own key to the control plane is minted during the install and stored protected. It is never a service argument." />
                        </Grid>
                    </StackPanel>

                    <!-- Agent -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Agent">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Agent" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Explain}"
                                   Text="The agent reconciles this machine against the applications enList says should run on it." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Agent name" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="Tags" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding AgentTags, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="key=value pairs, for example: env=prod role=web" />

                            <TextBlock Grid.Row="2" Text="Control plane" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding AgentControlPlaneUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Verify" Width="80" Height="28" Margin="8,8,0,0"
                                    Command="{Binding VerifyControlPlaneCommand}" />

                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                       Text="{Binding ControlPlaneVerdict}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}" />

                            <TextBlock Grid.Row="4" Text="Join token" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding AgentJoinToken, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Exchanged for this agent's own credential before the service is created. It is never stored in the service." />

                            <TextBlock Grid.Row="5" Text="Container engine" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding AgentEngine, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="wslc, docker, or empty for process isolation only." />

                            <!-- Only while no engine is chosen: once one is, the note below says what it needs instead. -->
                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="Leave the engine empty to run applications as ordinary processes. That is a supported agent, not a degraded one.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRunnerImageNote}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--
                                The runner image download. Shown as soon as an engine is typed, because this is
                                where the choice is made that needs it: the installer does not carry the image
                                and the agent never pulls one, so without this an agent installs cleanly and
                                every container application then fails to start. Amber rather than grey - it is
                                something to DO, not something to know.

                                The brief form, in the grey note's place, and the window is 660 high rather than
                                620 for it: the full sentence ran past the bottom of this page and was cut off,
                                with nothing to scroll. The Finish page has the room for the full one.
                            -->
                            <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="12,8"
                                    CornerRadius="8" Background="#1e1e2c" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                                    Visibility="{Binding HasRunnerImageNote, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding RunnerImageNote}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Ready -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="Ready">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Ready to install" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Explain}"
                                   Text="Nothing has been changed yet. Next starts the install." />

                        <Border Padding="16,12" CornerRadius="8" Background="#1e1e2c"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding Summary}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" Margin="0,3" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Installing and Finished, over the top of everything else -->
                <Border Background="{StaticResource Surface}" CornerRadius="12"
                        Visibility="{Binding Installing, Converter={StaticResource Visible}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Installing" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Explain}" HorizontalAlignment="Center" />
                        <!--
                            Mode=OneWay is REQUIRED, not tidiness. ProgressBar inherits Value from
                            RangeBase, where it is marked BindsTwoWayByDefault, so a plain binding
                            tries to write progress back into the view model - and Progress has a
                            private setter. WPF does not fail quietly: it throws
                            InvalidOperationException out of Window.Show(), which on this thread ends
                            the bootstrapper process and reaches the engine as nothing more
                            informative than a closed pipe.
                        -->
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="18" Margin="40,8" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" CornerRadius="12"
                        Visibility="{Binding Complete, Converter={StaticResource Visible}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Explain}" HorizontalAlignment="Center" />

                        <!-- The runner image download, again: the last thing read before the window closes. -->
                        <Border Margin="40,4,40,0" Padding="12,10" CornerRadius="8" Background="#1e1e2c"
                                BorderBrush="{StaticResource Warn}" BorderThickness="1"
                                Visibility="{Binding HasFinishNote, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding FinishNote}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>
