<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Contracts is referenced for the DTOs the tests assert on. Enlist.Agent used to be referenced here
    too, on the strength of a comment describing "one test that proves the full pipeline: enlist-deploy
    uploads and assigns, a real AgentHost picks it up and runs it". No such test exists, and no test
    in this project mentions AgentHost at all — the CLI creates no placement, so there was nothing for
    an agent to pick up. The reference and its justification were both removed on 2026-09-13.

    Deliberately NOT a ProjectReference to Enlist.Deploy or Enlist.ControlPlane themselves (both need
    to be spawned as real external processes anyway, and Enlist.ControlPlane's Sdk.Web framework
    references conflict with privately-copied packages elsewhere in the graph — see
    Enlist.Agent.Tests' note on this). ControlPlaneTestServer and RepoPaths (in Enlist.TestSupport)
    locate both built dlls by path instead.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Enlist.TestSupport\Enlist.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Enlist.ControlPlane.Contracts\Enlist.ControlPlane.Contracts.csproj" />
  </ItemGroup>

</Project>