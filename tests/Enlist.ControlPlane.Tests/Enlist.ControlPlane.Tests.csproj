<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- The same client the agent uses, so AuthenticationTests can prove the hub's group check from the outside. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <!-- ConfigurationBuilder, so ListenerRulesTests can ask the rule its question without a server. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Every test in this project spawns a REAL Enlist.ControlPlane process with its own LocalDB
    database. xunit defaults maxParallelThreads to the processor count, which on a 32-core machine
    meant up to 32 of those starting at the same instant against one LocalDB instance - and the
    assembly sat right on the edge of what that survives. At 92 tests it passed; the 93rd, whatever it
    was, made fifteen unrelated classes fail together with "address never announced within 30s". A
    capacity wall that presents as fifteen mystery failures is worse than a slow suite, so the cap is
    explicit here rather than inherited from whatever hardware happens to run it.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Deliberately NOT a ProjectReference to Enlist.ControlPlane itself (an ASP.NET Core / Sdk.Web
    project) — see Enlist.Agent.Tests' own note on this: mixing a Sdk.Web project's framework-supplied
    dependencies into a project that also needs privately-copied ones from elsewhere silently drops
    the private copies from THIS project's own output. ControlPlaneTestServer (in Enlist.TestSupport)
    locates the already-built Enlist.ControlPlane.dll by path instead.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Enlist.TestSupport\Enlist.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Enlist.ControlPlane.Contracts\Enlist.ControlPlane.Contracts.csproj" />
  </ItemGroup>

</Project>