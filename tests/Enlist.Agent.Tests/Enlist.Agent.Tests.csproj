<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Only so the container tests report as SKIPPED rather than passing silently on a machine with no Docker. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The same parallelism cap Enlist.ControlPlane.Tests carries, and for the same reason: every test
    here spawns real processes, and xunit defaults maxParallelThreads to the processor count. On a
    32-core machine that starts 32 of them at once, which the control plane assembly was found to
    survive only up to its 92nd test - see that project for the whole story. Capping costs no wall
    time (the bottleneck is process startup, not CPU) and stops the assembly from having a size limit
    that depends on the hardware.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Deliberately NOT a ProjectReference to Enlist.ControlPlane (an ASP.NET Core / Sdk.Web project,
    framework-supplied Microsoft.Extensions.Hosting) alongside Enlist.Agent (a console app with its
    own private copy of the same assembly, via Microsoft.Extensions.Hosting.WindowsServices): having
    both in one project's dependency graph made MSBuild's conflict resolution drop the private copy
    from this project's own output entirely, silently breaking every OTHER spawned enlist-agent.exe
    test (FileNotFoundException at runtime, nothing at compile time). ControlPlaneTestServer instead
    locates the already-built Enlist.ControlPlane.dll by path (RepoPaths-style), the same way
    RunnerBinDirectory() already does for Enlist.Runner — get the artifact without joining its build
    graph.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Enlist.Agent\Enlist.Agent.csproj" />
    <ProjectReference Include="..\Enlist.TestSupport\Enlist.TestSupport.csproj" />
  </ItemGroup>

</Project>