<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Not a test project itself, and it references no test framework: it is what the four test projects
    (ControlPlane, Agent, Deploy, Portal) share. Spawning real Enlist.ControlPlane and Enlist.Portal
    processes, starting and pinning LocalDB, locating build output, zipping test packages, waiting for
    a condition, killing a spawned process. Anything a second test project needs belongs here rather
    than copied - which is exactly how it started, with one harness duplicated between two projects.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

</Project>
