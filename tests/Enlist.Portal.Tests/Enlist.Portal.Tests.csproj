<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- So the Windows sign-in tests report as SKIPPED, with the reason, on a machine whose account cannot sign in over the network (see PortalAuthenticationTests). -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The same parallelism cap Enlist.ControlPlane.Tests carries, and for the same reason: every test
    here spawns real processes, and xunit defaults maxParallelThreads to the processor count. On a
    32-core machine that starts 32 of them at once, which the control plane assembly was found to
    survive only up to its 92nd test - see that project for the whole story. Capping costs no wall
    time (the bottleneck is process startup, not CPU) and stops the assembly from having a size limit
    that depends on the hardware.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    References Enlist.Portal directly: what is tested here (Services/TagSelectorMatcher,
    Services/PolicyConflictDetector) are pure functions over contract DTOs compiled into the portal
    assembly - the copies the portal keeps of decisions the control plane makes, which is exactly why
    they need pinning. No bUnit and no browser: component rendering is still verified by hand
    (docs/05-operations/Test-Plan.md, section 5). The Sdk.Web caveat in Enlist.Agent.Tests does not
    apply here - nothing else in this graph carries a private copy of a framework-supplied assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Enlist.Portal\Enlist.Portal.csproj" />
    <!-- ControlPlaneTestServer and PortalTestServer: the authentication tests drive the real portal, as a process, against a real control plane. -->
    <ProjectReference Include="..\Enlist.TestSupport\Enlist.TestSupport.csproj" />
  </ItemGroup>

</Project>
