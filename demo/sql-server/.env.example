# Copy to .env and set a password before the first `demo-db.ps1 up`.
#
#   cp .env.example .env
#
# This directory is checked in; the .env you create from it is not meant to be. There is no
# .gitignore in this tree yet (it is not a git repository), so if that changes, add `demo/**/.env`
# to it. Keep .env and .env.example in step when you add a setting.

# SQL Server rejects anything under 8 characters or missing three of {upper, lower, digit,
# symbol}, and it fails at container START with a message buried in `wslc logs enlist-demo-sql`,
# not at connect time. Pick something that satisfies it.
#
# This is a demo server on a developer laptop, reachable only on 127.0.0.1. It is not a production
# credential and must never become one -- see README.md "What this is not".
MSSQL_SA_PASSWORD=ChangeMe_Demo123!

# Host port. The container always listens on 1433 internally; this is what the host maps it to,
# on 127.0.0.1 only. 14330 avoids the SQL Server already installed on this machine.
MSSQL_PORT=14330

# The image tag demo-db.ps1 runs. Pinned to match the LocalDB build used for local dev (SQL Server
# 2025 RTM-CU3, 17.0.4025.3), so a behaviour difference can never be the surprise that derails a
# live demo. There is no 2025-latest tag on MCR, only explicit CU tags; check
# `curl -s https://mcr.microsoft.com/v2/mssql/server/tags/list` before bumping.
MSSQL_TAG=2025-CU3-ubuntu-24.04
