<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The iC mark on Enlist.ControlPlane.exe, which is what Task Manager shows for the running
      service. Shared by all three services from src\branding; see the README there.
    -->
    <ApplicationIcon>..\branding\enlist.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      10.0.11, NOT 10.0.0, and this is the odd version in the tree on purpose. 10.0.0 drags in
      Microsoft.OpenApi 2.0.0 transitively, which carries a known HIGH severity advisory
      (GHSA-v5pm-xwqc-g5wc). A 2026-09-12 review flagged this line as a version inconsistency worth
      tidying; tidying it reintroduced the vulnerability within the minute, which is how it was
      found. Move it forward, never back, and run the SDK's vulnerable-package audit afterwards
      (dotnet list package, with the vulnerable switch).
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!--
      Lets this host run as a Windows Service (SCM auto-start, a real stop signal) without giving up
      IIS or `dotnet run` — the same binary serves all three. AddWindowsService() and
      WindowsServiceHelpers.IsWindowsService() both no-op outside an actual service context, so
      nothing changes for the other two. See Program.cs and docs/05-operations/Deployment-IaC.md §1.6.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enlist.ControlPlane.Contracts\Enlist.ControlPlane.Contracts.csproj" />
  </ItemGroup>

  <!--
    Roslyn's MSBuild build host, left out of PUBLISH and kept in the build.

    Microsoft.EntityFrameworkCore.Design is design-time tooling for `dotnet ef`, and PrivateAssets=all
    already keeps its assemblies out of publish - the SDK treats a private package as Publish=false.
    But one of its dependencies, Microsoft.CodeAnalysis.Workspaces.MSBuild, carries its build host as
    NuGet CONTENT files (BuildHost-net472\, with Microsoft.CodeAnalysis.Workspaces.MSBuild.BuildHost.exe,
    and BuildHost-netcore\), and content files reach publish by a different route that Publish=false
    does not cover. So about 4 MB of a tool for loading C# projects was installed beside every
    control plane, which never loads a project.

    Matched by the package the files came from rather than by folder name, so a renamed folder in a
    later Roslyn does not quietly slip back in. The build output keeps them: `dotnet ef` runs against
    bin\, and some of its commands (dbcontext optimize) do load the project. installer\verify.ps1
    checks that no design-time tooling reaches any package.
  -->
  <Target Name="LeaveDesignTimeBuildHostOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_DesignTimeBuildHostFile Include="@(ResolvedFileToPublish)"
                                Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').ToLowerInvariant().Contains('microsoft.codeanalysis.workspaces.msbuild'))" />
      <ResolvedFileToPublish Remove="@(_DesignTimeBuildHostFile)" />
    </ItemGroup>
  </Target>

</Project>
