<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Cronos is the cron arithmetic the agent schedules with. It lives here too so there is ONE
    definition of what enList accepts as a cron expression (CronExpressions): the control plane
    refuses a bad override at the API and the portal says so before sending, instead of an agent
    discovering the typo in its log after the rule was stored. The runner is unaffected — it never
    references this assembly.
  -->
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.11.0" />
  </ItemGroup>

  <!--
    Configuration.Abstractions is here for the same reason Cronos is: ListenerRules.ConfiguredUrls
    is the ONE definition of where a listen address can come from, and the control plane and the
    portal both ask it. They each had their own copy until 2026-09-12, and both copies were blind to
    ASPNETCORE_HTTP_PORTS — which is exactly the drift a shared definition prevents.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
