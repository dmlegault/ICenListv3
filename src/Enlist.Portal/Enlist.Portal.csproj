<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The iC mark on Enlist.Portal.exe, shared by all three services from src\branding. -->
    <ApplicationIcon>..\branding\enlist.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.6.0" />
    <!--
      Lets this host run as a Windows Service without giving up IIS or `dotnet run` — see Program.cs
      and docs/05-operations/Deployment-IaC.md §1.6. The content-root handling in Program.cs matters MORE here than
      for the control plane: this app serves static assets, and a wrong content root breaks them
      silently (the page loads unstyled with no error — see Runbook.md).
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!--
      Windows authentication for the people who use the portal (Authentication-Design.md section 5):
      Negotiate on Kestrel - Kerberos in a domain, NTLM against local accounts. No password store of
      our own, ever.

      10.0.11 at minimum. 10.0.0, which this shipped on until 2026-09-12, carries TWO known high
      severity advisories (GHSA-2p3q-h3hg-jcqq and GHSA-8prm-248r-h957) - on the package that
      authenticates every person who opens the portal. Found by accident while checking an unrelated
      version bump, which is the argument for running the SDK's vulnerable-package audit on purpose
      (dotnet list package, with the vulnerable switch).
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <!-- DPAPI, for the portal's control-plane key in configuration (Services/PortalCredential.cs): machine scope, this machine only. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Design doc section 8: "The portal never talks to an agent" — only the control plane's DTOs are needed here, same reasoning as Enlist.Deploy referencing this and nothing else. -->
  <ItemGroup>
    <ProjectReference Include="..\Enlist.ControlPlane.Contracts\Enlist.ControlPlane.Contracts.csproj" />
  </ItemGroup>

</Project>
