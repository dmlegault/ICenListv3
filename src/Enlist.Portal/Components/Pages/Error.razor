@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<MudStack Spacing="4">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        An error occurred while processing your request.
    </MudAlert>

    @if (ShowRequestId)
    {
        <MudText Typo="Typo.body1">
            <MudText Typo="Typo.subtitle2" Inline="true">Request ID:</MudText> @RequestId
        </MudText>
    }

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h6">Development mode</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            Swapping to the Development environment will show more detail about the error. It shouldn't be
            enabled for deployed applications - it can expose sensitive information from exceptions to end
            users. For local debugging, set the ASPNETCORE_ENVIRONMENT environment variable to Development
            and restart the app.
        </MudText>
    </MudPaper>
</MudStack>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
