@page "/access"
@attribute [Authorize(Policy = PortalRoles.Operator)]
@inject ControlPlaneApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject PortalAuthenticationOptions Authentication

<PageTitle>Access</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Access</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Three kinds of caller, three kinds of credential. <b>People</b> sign in with Windows; who is an Operator and who is a
    Viewer is two group names in this portal's configuration (@Group(Authentication.Windows.OperatorsGroup) /
    @Group(Authentication.Windows.ViewersGroup)). <b>Agents</b> enroll once with a join token and keep their own
    credential (Agents tab). <b>Tools</b> present an API key with a role. Every secret is shown once, here, and stored
    only as a hash.
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6">Join tokens</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="EnrollAsync">Enroll agent</MudButton>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" title="Refresh" />
</MudStack>
@if (_joinTokens is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_joinTokens.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mb-6">No join tokens have been minted. Enroll agent creates one and shows it once.</MudAlert>
}
else
{
    <MudTable Items="_joinTokens" Breakpoint="Breakpoint.Sm" Hover="true" Dense="true" Class="mb-6">
        <HeaderContent>
            <MudTh>Created</MudTh>
            <MudTh>By</MudTh>
            <MudTh>Expires</MudTh>
            <MudTh>Enrollments left</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Created">@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="By">@context.CreatedBy</MudTd>
            <MudTd DataLabel="Expires">@context.ExpiresAtUtc.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="Enrollments left">@(context.UsesRemaining?.ToString() ?? "unlimited")</MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip></MudTd>
            <MudTd>
                @if (context.Status == CredentialStatuses.Live)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="@(() => RevokeJoinTokenAsync(context))" title="Revoke" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6">API keys</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateKeyAsync">New API key</MudButton>
</MudStack>
@if (_apiKeys is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_apiKeys.Count == 0)
{
    <MudAlert Severity="Severity.Info">No API keys. New API key creates one and shows it once.</MudAlert>
}
else
{
    <MudTable Items="_apiKeys" Breakpoint="Breakpoint.Sm" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Expires</MudTh>
            <MudTh>Last used</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Role">@context.Role</MudTd>
            <MudTd DataLabel="Created">@context.CreatedAtUtc.ToLocalTime().ToString("g") <MudText Typo="Typo.caption" Inline="true">by @context.CreatedBy</MudText></MudTd>
            <MudTd DataLabel="Expires">@(context.ExpiresAtUtc is { } e ? e.ToLocalTime().ToString("g") : "never")</MudTd>
            <MudTd DataLabel="Last used">@(context.LastUsedAtUtc is { } u ? u.ToLocalTime().ToString("g") : "never")</MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip></MudTd>
            <MudTd>
                @if (context.Status == CredentialStatuses.Live)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="@(() => RevokeKeyAsync(context))" title="Revoke" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<JoinTokenDto>? _joinTokens;
    private List<ApiKeyDto>? _apiKeys;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _joinTokens = null;
        _apiKeys = null;
        try
        {
            _joinTokens = await Api.GetJoinTokensAsync();
            _apiKeys = await Api.GetApiKeysAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _joinTokens ??= [];
            _apiKeys ??= [];
        }
    }

    private static string Group(string? name) => string.IsNullOrWhiteSpace(name) ? "not configured" : name;

    private static Color StatusColor(string status) => status switch
    {
        CredentialStatuses.Live => Color.Success,
        CredentialStatuses.Expired => Color.Warning,
        _ => Color.Default,
    };

    private async Task EnrollAsync()
    {
        var dialog = await DialogService.ShowAsync<EnrollAgentDialog>("Enroll an agent", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task CreateKeyAsync()
    {
        var dialog = await DialogService.ShowAsync<CreateApiKeyDialog>("New API key", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task RevokeJoinTokenAsync(JoinTokenDto token)
    {
        var confirmed = await DialogService.ShowMessageBox("Revoke this join token", "Nothing can enroll with it from now on. Agents already enrolled keep their credentials.", yesText: "Revoke", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.RevokeJoinTokenAsync(token.Id);
            Snackbar.Add("Join token revoked.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RevokeKeyAsync(ApiKeyDto key)
    {
        var confirmed = await DialogService.ShowMessageBox($"Revoke '{key.Name}'", "Whatever presents this key gets 401 from now on. A portal holding it stops working until it is given a new one.", yesText: "Revoke", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.RevokeApiKeyAsync(key.Name);
            Snackbar.Add($"Key '{key.Name}' revoked.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
