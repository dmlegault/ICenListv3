@page "/agents"
@inject ControlPlaneApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Agents</PageTitle>

@if (_agents is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_agents.Count == 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="mb-2">
        <AuthorizeView Policy="@PortalRoles.Operator" Context="access">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="EnrollAsync">Enroll agent</MudButton>
        </AuthorizeView>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" title="Refresh" />
    </MudStack>
    <MudAlert Severity="Severity.Info">
        No agents have registered yet — an agent appears here automatically the first time it fetches
        its policies, or you can pre-register one with tags before that happens. A control plane that
        requires authentication admits an agent only once it has enrolled with a join token: Enroll agent.
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="mb-2">
        <AuthorizeView Policy="@PortalRoles.Operator" Context="access">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="EnrollAsync">Enroll agent</MudButton>
        </AuthorizeView>
    </MudStack>
    <div class="app-list">
        <div class="app-list-header">
            <span></span>
            <span>Agent</span>
            <span>Tags</span>
            <span>Applications</span>
            <span>Policy Rules</span>
            <span>Last Seen</span>
            <span>Status</span>
            <span>Enabled</span>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadAsync" title="Refresh" />
        </div>
        @foreach (var row in _agents)
        {
            <div class="app-card">
                <div class="app-card-row">
                    <MudIconButton Icon="@(row.IsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   Size="Size.Small" OnClick="@(() => ToggleExpand(row))" />
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <span>@row.Agent.Name</span>
                        @{ var engine = row.Agent.Capabilities?.ContainerEngine; }
                        @if (engine is { Available: true })
                        {
                            <MudTooltip Text="@ContainerReadyTooltip(engine)">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                         Icon="@Icons.Material.Filled.Inventory2">containers</MudChip>
                            </MudTooltip>
                        }
                        else if (engine is not null)
                        {
                            @* Configured for containers but the engine did not answer. This is the state worth
                               showing loudest: the agent will ACCEPT a container policy and then fail it, and
                               without this the failure looks like enList being broken rather than a stopped
                               daemon. An agent never configured for containers shows nothing at all — process
                               is the default and a chip on every such agent would be noise. *@
                            <MudTooltip Text="@ContainerBrokenTooltip(engine)">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.WarningAmber">engine down</MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        @if (row.Agent.Tags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info">none</MudText>
                        }
                        else
                        {
                            @foreach (var tag in row.Agent.Tags)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@tag.Key=@tag.Value</MudChip>
                            }
                        }
                        <AuthorizeView Policy="@PortalRoles.Operator" Context="access">
                            <MudIconButton Icon="@Icons.Material.Filled.Label" Size="Size.Small" OnClick="@(() => EditTagsAsync(row.Agent))" title="Edit tags" />
                        </AuthorizeView>
                    </MudStack>
                    <div>@Stats(row.Agent.Name).ApplicationCount</div>
                    <div>@Stats(row.Agent.Name).PolicyCount</div>
                    <div>@FormatRelative(row.Agent.LastSeenUtc)</div>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (IsOnline(row.Agent.LastSeenUtc))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Online</MudChip>
                            @if (row.Agent.Capabilities?.PushChannel is { } channel && channel != PushChannelStates.Connected)
                            {
                                @* Heartbeats travel over HTTP and keep an agent Online while its push connection is
                                   down — the state in which a policy change reaches it late. The two look identical
                                   otherwise, which is exactly why this gets its own chip. *@
                                <MudTooltip Text="@PushChannelTooltip(channel)">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Filled.SyncProblem">not receiving</MudChip>
                                </MudTooltip>
                            }
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">Offline</MudChip>
                        }
                        @if (row.Agent.CredentialState == AgentCredentialStates.Live)
                        {
                            <MudTooltip Text="Enrolled: this agent presents its own credential on every call. Revoke it (key icon) to move the name to another machine.">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                         Icon="@Icons.Material.Filled.VerifiedUser">enrolled</MudChip>
                            </MudTooltip>
                        }
                        else if (row.Agent.CredentialState == AgentCredentialStates.Revoked)
                        {
                            @* Under Required this agent is refused on every call; it keeps running what it
                               runs and says so in its log. A new join token and a restart puts it back. *@
                            <MudTooltip Text="Its credential was revoked: every call is refused until it re-enrolls with a new join token (restart it once with --join-token).">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                         Icon="@Icons.Material.Filled.KeyOff">credential revoked</MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <AuthorizeView Policy="@PortalRoles.Operator" Context="access">
                            <MudSwitch T="bool" Value="@row.Agent.SchedulingEnabled" Color="Color.Success"
                                       Disabled="_schedulingPending" ValueChanged="@(_ => ToggleSchedulingAsync(row.Agent))" />
                        </AuthorizeView>
                        @if (row.Agent.SchedulingEnabled)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Enabled</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Disabled</MudChip>
                        }
                    </MudStack>
                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                        <AuthorizeView Policy="@PortalRoles.Operator" Context="access">
                            @if (row.Agent.CredentialState == AgentCredentialStates.Live)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyOff" Size="Size.Small" Color="Color.Warning" OnClick="@(() => RevokeCredentialAsync(row.Agent))" title="Revoke credential" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(row.Agent))" title="Delete" />
                        </AuthorizeView>
                    </MudStack>
                </div>
                @if (row.IsExpanded)
                {
                    <div class="app-card-expanded">
                        <AgentRunningApplicationsTable AgentName="@row.Agent.Name" @key="@row.Agent.Name" />
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>The version is the proof the probe genuinely reached a daemon rather than just finding the CLI on PATH.</summary>
    private static string ContainerReadyTooltip(ContainerEngineStatus e) =>
        $"{EngineLabel(e)} reachable{(string.IsNullOrWhiteSpace(e.Version) ? "" : $" (v{e.Version})")} — image {e.Image}. Checked {e.CheckedAtUtc.ToLocalTime():HH:mm:ss}.";

    private static string EngineLabel(ContainerEngineStatus e) => e.Engine switch
    {
        "wslc" => "WSL container engine (wslc)",
        "docker" => "Docker engine",
        _ => "Container engine",
    };

    /// <summary>Carries the engine's own error text: an operator needs to know WHY it is unreachable, not merely that it is.</summary>
    private static string ContainerBrokenTooltip(ContainerEngineStatus e) =>
        $"This agent is configured for containers but its engine ({e.Engine ?? "unknown"}) did not respond, so any container policy will FAIL here. {e.Error}";

    private List<AgentRow>? _agents;
    private Dictionary<string, AgentStat> _stats = new(StringComparer.OrdinalIgnoreCase);
    private bool _schedulingPending;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var previouslyExpanded = _agents?.Where(a => a.IsExpanded).Select(a => a.Agent.Name).ToHashSet(StringComparer.OrdinalIgnoreCase)
            ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        _agents = null;
        StateHasChanged();

        List<AgentDto> agents;
        List<ApplicationPolicyDto> policies;
        try
        {
            agents = await Api.GetAgentsAsync();
            policies = await Api.GetApplicationPoliciesAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            agents = [];
            policies = [];
        }

        _stats = ComputeStats(agents, policies);
        _agents = agents.Select(a => new AgentRow(a) { IsExpanded = previouslyExpanded.Contains(a.Name) }).ToList();
    }

    private void ToggleExpand(AgentRow row) => row.IsExpanded = !row.IsExpanded;

    private AgentStat Stats(string agentName) =>
        _stats.TryGetValue(agentName, out var stat) ? stat : new AgentStat(0, 0);

    /// <summary>Mirrors Applications.razor's own tag-selector resolution (TagSelectorMatcher) but inverted: grouped by agent instead of by application, so each row here can show how many distinct applications and how many policy rules govern it — including rules a tag selector fans out to this agent, not just ones naming it directly.</summary>
    private static Dictionary<string, AgentStat> ComputeStats(List<AgentDto> agents, List<ApplicationPolicyDto> policies)
    {
        var byAgent = new Dictionary<string, List<ApplicationPolicyDto>>(StringComparer.OrdinalIgnoreCase);
        foreach (var agent in agents)
        {
            byAgent[agent.Name] = [];
        }

        foreach (var policy in policies)
        {
            var names = TagSelectorMatcher.ResolveAgentNames(agents, policy.TagSelector);

            foreach (var name in names)
            {
                if (!byAgent.TryGetValue(name, out var list))
                {
                    list = [];
                    byAgent[name] = list;
                }

                list.Add(policy);
            }
        }

        return byAgent.ToDictionary(
            kv => kv.Key,
            kv => new AgentStat(kv.Value.Select(a => a.ApplicationName).Distinct(StringComparer.OrdinalIgnoreCase).Count(), kv.Value.Count),
            StringComparer.OrdinalIgnoreCase);
    }

    private sealed record AgentStat(int ApplicationCount, int PolicyCount);

    private sealed class AgentRow(AgentDto Agent)
    {
        public AgentDto Agent { get; } = Agent;
        public bool IsExpanded { get; set; }
    }

    private static string PushChannelTooltip(string channel) =>
        $"Heartbeats arrive, but this agent's push connection to the control plane is {channel}. " +
        "Policy changes still reach it on its periodic re-check (every few minutes) and the moment the connection returns.";

    private static bool IsOnline(DateTimeOffset lastSeenUtc) => DateTimeOffset.UtcNow - lastSeenUtc < TimeSpan.FromMinutes(5);

    private static string FormatRelative(DateTimeOffset timestamp)
    {
        var age = DateTimeOffset.UtcNow - timestamp;
        if (age < TimeSpan.FromMinutes(1))
        {
            return "just now";
        }

        if (age < TimeSpan.FromHours(1))
        {
            return $"{(int)age.TotalMinutes}m ago";
        }

        if (age < TimeSpan.FromDays(1))
        {
            return $"{(int)age.TotalHours}h ago";
        }

        return $"{(int)age.TotalDays}d ago";
    }

    private async Task EditTagsAsync(AgentDto agent)
    {
        var parameters = new DialogParameters<EditTagsDialog>
        {
            { d => d.AgentName, agent.Name },
            { d => d.CurrentTags, agent.Tags },
        };
        var dialog = await DialogService.ShowAsync<EditTagsDialog>("Edit tags", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    /// <summary>Disabling is the one direction that needs a warning — it's the "stop everything on this box" action, the same posture ApplicationPolicyStateToggler already uses before a broad Disable. Enabling doesn't need confirmation: it's the safe direction, an agent only ever becomes eligible again for whatever already targets it, nothing starts unexpectedly on its own.</summary>
    private async Task ToggleSchedulingAsync(AgentDto agent)
    {
        var newValue = !agent.SchedulingEnabled;

        if (!newValue)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Disable this agent",
                $"'{agent.Name}' will stop running everything it currently hosts and won't pick up any policy rule — even one that already matches it — until it's re-enabled. Continue?",
                yesText: "Disable",
                cancelText: "Cancel");

            if (confirmed != true)
            {
                return;
            }
        }

        _schedulingPending = true;
        try
        {
            await Api.SetAgentSchedulingAsync(agent.Name, newValue);
            Snackbar.Add($"{agent.Name} {(newValue ? "enabled" : "disabled")}.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _schedulingPending = false;
        }
    }

    /// <summary>A join token is what an operator hands to a machine they have not met yet; the dialog mints one and shows it once.</summary>
    private async Task EnrollAsync()
    {
        await DialogService.ShowAsync<EnrollAgentDialog>("Enroll an agent", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    /// <summary>The agent keeps running what it runs and is refused from its next call on; the name is free for a new machine. The confirmation says exactly that, because "revoke" sounds like "stop" and is not.</summary>
    private async Task RevokeCredentialAsync(AgentDto agent)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Revoke this agent's credential",
            $"'{agent.Name}' keeps running everything it hosts, but every call it makes from now on is refused until it re-enrolls with a new join token (restart it once with --join-token). Do this to move the name to another machine, or if the machine is compromised.",
            yesText: "Revoke",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.RevokeAgentCredentialAsync(agent.Name);
            Snackbar.Add($"{agent.Name}'s credential revoked.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(AgentDto agent)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete agent",
            $"Remove '{agent.Name}' from the registry? This also revokes its credential: with authentication on it cannot come back under that name without a new join token; with authentication off it reappears the next time it reports in.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteAgentAsync(agent.Name);
            Snackbar.Add("Agent deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
