<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Enlist.Deploy</RootNamespace>
    <AssemblyName>enlist-deploy</AssemblyName>
  </PropertyGroup>

  <!--
    The one-command answer to "log into each machine individually and copy files by hand": zip a
    build, upload it to the control plane, and create-or-update an assignment for the target
    machine(s) or label selector — everything Enlist.ControlPlane's REST API already does, wrapped so
    a person doesn't have to hand-type curl calls per machine to use it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Enlist.ControlPlane.Contracts\Enlist.ControlPlane.Contracts.csproj" />
  </ItemGroup>

</Project>
